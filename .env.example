NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Stable NileStock URL used after email confirmation and OAuth sign-in.
NEXT_PUBLIC_SITE_URL=https://nilestock.vercel.app
# Automatically supplied by Vercel; do not set this manually.
# NEXT_PUBLIC_VERCEL_URL=nilestock-preview-team.vercel.app
NEXT_PUBLIC_FOUNDER_EMAIL=your-founder-email@example.com
OPENAI_API_KEY=your-server-only-openai-key
OPENAI_MODEL=gpt-5.6-luna
